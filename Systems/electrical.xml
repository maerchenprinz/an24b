<?xml version="1.0"?>

<system name="Electrical">

<!--##########################################
#### DC 27V
##############################################-->

<!--##############################
#### Sources
##################################-->

<!--
### STG-18 Generators ###-->
 <channel name="STG-18_V" execrate="16">

 <fcs_function name="/an24/Electrics/DC_Gen_18TMOl_V">
  <function>

 <product>
 <property>/an24/Electrical_Panel/stg-18l_voltreg</property><!--TODO: make it +-1.5V-->
 <property>/an24/Electrics/random_stg18l</property>
 <sum>
  <pow>
   <difference>
    <quotient>
    <property>propulsion/engine[0]/engine-rpm-percent</property>
    <value>100</value>
    </quotient>
   <value>1.1</value>
   </difference>
  <value>5.0</value>
  </pow>
 <value>1.0</value>
 </sum>
 </product>

  </function>
  <clipto>
   <min>0.0</min>
   <max>100.0</max>
  </clipto>
 </fcs_function>

 <fcs_function name="/an24/Electrics/DC_Gen_18TMOr_V">
  <function>

 <product>
 <property>/an24/Electrical_Panel/stg-18r_voltreg</property><!--TODO: make it +-1.5V-->
 <property>/an24/Electrics/random_stg18r</property>
 <sum>
  <pow>
   <difference>
    <quotient>
    <property>propulsion/engine[1]/engine-rpm-percent</property>
    <value>100</value>
    </quotient>
   <value>1.1</value>
   </difference>
  <value>5.0</value>
  </pow>
 <value>1.0</value>
 </sum>
 </product>

  </function>
  <clipto>
   <min>0.0</min>
   <max>100.0</max>
  </clipto>
 </fcs_function>

 </channel>

<!--
### RK_Nacelle (GS-24 or Aerodrome Power) ###-->
 <channel name="GS-24_V" execrate="32">

 <fcs_function name="/an24/Electrics/DC_Gen_GS-24_V">
  <function>

 <product>
 <property>/an24/Electrical_Panel/gs24_voltreg</property><!--TODO: make it +-1.5V-->
 <property>/an24/Electrics/random_gs24</property>
 <sum>
  <pow>
   <difference>
    <quotient>
    <property>/engines/engine[2]/n1</property>
    <value>90.9</value>
    </quotient>
   <value>1.1</value>
   </difference>
  <value>5.0</value>
  </pow>
 <value>1.0</value>
 </sum>
 </product>

  </function>
  <clipto>
   <min>0.0</min>
   <max>100.0</max>
  </clipto>
 </fcs_function>

 </channel>

 <channel name="Aerodrome Sources" execrate="60">

 <fcs_function name="/an24/Electrics/DC_Aerodrome_V">
  <function>

   <ifthen>

    <nq>
     <sum>
      <property>/sim/gui/an24b/shrap500a</property>
      <property>/sim/gui/an24b/shrap500b</property>
     </sum>
     <value>0</value>
    </nq>

    <quotient>
     <sum>
      <property>/an24/Electrics/DC_AUX_ShRAP500a_V</property>
      <property>/an24/Electrics/DC_AUX_ShRAP500b_V</property>
     </sum>
     <sum>
      <property>/sim/gui/an24b/shrap500a</property>
      <property>/sim/gui/an24b/shrap500b</property>
     </sum>
    </quotient>

    <value>0.0</value>
   </ifthen>

  </function>
 </fcs_function>

 </channel>

 <channel name="RK Nacelle" execrate="120">

  <switch name="/an24/Electrics/RK_Nacelle_V">
   <default value="0"/>
   <test value="/an24/Electrics/DC_Aerodrome_V">
	/an24/Electrics/DC_Aerodrome_V GT 16.0
   </test>
   <test value="/an24/Electrics/DC_Gen_GS-24_V">
	/an24/Electrics/DMR-600Tgs EQ 1
   </test>
  </switch>

 </channel>

<!--
### RK Akku ###-->
 <channel name="Batteries" execrate="60">

 <fcs_function name="/an24/Electrics/Akkus_V">
  <function>

   <ifthen>

    <nq>
     <sum>
      <property>/an24/Electrics/CONN_Akku1-RK_Akku</property>
      <property>/an24/Electrics/CONN_Akku2-RK_Akku</property>
     </sum>
     <value>0</value>
    </nq>

    <quotient>
     <sum>
      <product>
       <property>/an24/Electrics/CONN_Akku1-RK_Akku</property>
       <property>/an24/Electrics/DC_Batt_12SAM1_V</property>
      </product>
      <product>
       <property>/an24/Electrics/CONN_Akku2-RK_Akku</property>
       <property>/an24/Electrics/DC_Batt_12SAM2_V</property>
      </product>
     </sum>
     <sum>
      <property>/an24/Electrics/CONN_Akku1-RK_Akku</property>
      <property>/an24/Electrics/CONN_Akku2-RK_Akku</property>
     </sum>
    </quotient>

    <value>0.0</value>
   </ifthen>

  </function>
 </fcs_function>

  <switch name="/an24/Electrics/RK_Akku_V">
   <default value="/an24/Electrics/Akkus_V"/>
   <test logic="AND" value="/an24/Electrics/RK_CrewCab_V">
	/an24/Electrics/CONN_RK_Akku-RK_CrewCab EQ 1
	/an24/Electrics/Akkus_V LT /an24/Electrics/RK_CrewCab_V
   </test>
   <test logic="AND" value="/an24/Electrics/AZSemerg_V">
	/an24/Electrics/CONN_RK_Akku-AZSemerg EQ 1
	/an24/Electrics/Akkus_V LT /an24/Electrics/AZSemerg_V
   </test>
  </switch>

 </channel>

<!--
### DMR-600T Differential Relais' ###-->
 <channel name="DMR-600Ts" execrate="32">

 <summer name="/an24/Electrics/DMR-600Tl-reference">
  <input>/an24/Electrics/TsRUl_V</input>
  <bias>-0.5</bias><!--adjustable from 0.2-1.0V-->
 </summer>

 <summer name="/an24/Electrics/DMR-600Tr-reference">
  <input>/an24/Electrics/TsRUr_V</input>
  <bias>-0.5</bias><!--adjustable from 0.2-1.0V-->
 </summer>

  <switch name="/an24/Electrics/DMR-600Tl">
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/Electrics/DC_AUX_ShRAP500a_V LT 16.0<!--Relais (Item 709) blocking DMR via AZP-8M-->
	/an24/Electrics/DC_AUX_ShRAP500b_V LT 16.0<!--Relais (Item 709) blocking DMR via AZP-8M-->
<!--	/an24/Electrical_Panel/sw_board-aerodrome NE 0 Relais (Item 709) blocking DMR via AZP-8M, not sure...-->
	/an24/Electrical_Panel/sw_stg18l EQ 1.0
	/an24/Electrics/DC_Gen_18TMOl_V GT /an24/Electrics/DMR-600Tl-reference
	/an24/Electrics/DC_Gen_18TMOl_V GE 24.0
	/an24/Electrics/DC_Gen_18TMOl_V LT 30.0 <!--actually by AZP-8M-->
   </test>
  </switch>

  <switch name="/an24/Electrics/DMR-600Tr">
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/Electrics/DC_AUX_ShRAP500a_V LT 16.0<!--Relais (Item 752) blocking DMR via AZP-8M-->
	/an24/Electrics/DC_AUX_ShRAP500b_V LT 16.0<!--Relais (Item 752) blocking DMR via AZP-8M-->
<!--	/an24/Electrical_Panel/sw_board-aerodrome NE 0 Relais (Item 752) blocking DMR via AZP-8M, not sure...-->
	/an24/Electrical_Panel/sw_stg18r EQ 1.0
	/an24/Electrics/DC_Gen_18TMOr_V GT /an24/Electrics/DMR-600Tr-reference
	/an24/Electrics/DC_Gen_18TMOr_V GE 24.0
	/an24/Electrics/DC_Gen_18TMOr_V LT 30.0 <!--actually by AZP-8M-->
   </test>
  </switch>

  <switch name="/an24/Electrics/DMR-600Tgs">
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/Electrics/DC_AUX_ShRAP500a_V LT 16.0
	/an24/Electrics/DC_AUX_ShRAP500b_V LT 16.0
	/an24/Electrical_Panel/sw_gs24 EQ 1.0<!--Relais (Item 738) blocking DMR-->
	/an24/Electrics/DC_Gen_GS-24_V GT /an24/Electrics/DMR-600Tl-reference<!--same value as for left gen-->
	/an24/Electrics/DC_Gen_GS-24_V GT 24.0
   </test>
  </switch>

 </channel>

 <channel name="STG parallel" execrate="16">

 <fcs_function name="/an24/Electrics/DC_Gen_18TMOparallel_V">
  <function>
   <quotient>
    <sum>
     <product>
      <property>/an24/Electrics/DC_Gen_18TMOl_V</property>
      <property>/an24/Electrics/DMR-600Tl</property>
     </product>
     <product>
      <property>/an24/Electrics/DC_Gen_18TMOr_V</property>
      <property>/an24/Electrics/DMR-600Tr</property>
     </product>
    </sum>
    <sum>
     <property>/an24/Electrics/DMR-600Tl</property>
     <property>/an24/Electrics/DMR-600Tr</property>
    </sum>
   </quotient>
  </function>
 </fcs_function>

 </channel>

<!--##########################################
#### DC CONNECTIONS
##############################################-->
 <channel name="DC Connections" execrate="32">

<!--
### Inner Circle ###-->
  <switch name="/an24/Electrics/CONN_TsRUl-TsRUr">
   <default value="0"/>
   <test value="1">
	/an24/Electrics/FUSE_TsRUl-TsRUr EQ 1
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_TsRUr-RK_CrewCab">
   <default value="0"/>
   <test logic="OR" value="1">
	<test logic="AND">
	/an24/Electrics/FUSE_TsRUr-RK_CrewCab1a EQ 1
	/an24/Electrics/FUSE_TsRUr-RK_CrewCab1b EQ 1
 	</test>
	<test logic="AND">
	/an24/Electrics/FUSE_TsRUr-RK_CrewCab2a EQ 1
	/an24/Electrics/FUSE_TsRUr-RK_CrewCab2b EQ 1
 	</test>
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_RK_CrewCab-AZSmain">
   <default value="1"/>
   <test logic="OR" value="0">
	/an24/Electrics/FUSE_RK_CrewCab-AZSmaina EQ 0
	/an24/Electrics/FUSE_RK_CrewCab-AZSmainb EQ 0
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_TsRUl-AZSmain">
   <default value="0"/>
   <test logic="OR" value="1">
	<test logic="AND">
	/an24/Electrics/FUSE_TsRUl-AZSmain1a EQ 1
	/an24/Electrics/FUSE_TsRUl-AZSmain1b EQ 1
 	</test>
	<test logic="AND">
	/an24/Electrics/FUSE_TsRUl-AZSmain2a EQ 1
	/an24/Electrics/FUSE_TsRUl-AZSmain2b EQ 1
 	</test>
   </test>
  </switch>

<!--
### Consumers ###-->
  <switch name="/an24/Electrics/CONN_TsRUr-RK_FlAttmain">
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/Electrics/FUSE_TsRUr-RK_FlAttmain EQ 1
	/an24/Electrics/CONN_TsRUl-RK_FlAttmain EQ 0
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_TsRUl-RK_FlAttmain">
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/Electrics/FUSE_TsRUl-RK_FlAttmain EQ 1
	/an24/Electrics/TsRUl_V GT 20.0 <!--Relais (Item 1510)-->
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_AZSemerg-RK_FlAttemerg">
   <default value="1"/>
   <test value="0">
	/an24/Electrics/FUSE_AZSemerg-RK_FlAttemerg EQ 0
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_TsRUr-RK_FuelPumps">
   <default value="1"/>
   <test logic="OR" value="0">
	/an24/Electrics/FUSE_TsRUr-RK_FuelPumps EQ 0
	/an24/Electrics/CONN_TsRUl-RK_FuelPumps EQ 1
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_TsRUl-RK_FuelPumps">
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/Electrics/FUSE_TsRUl-RK_FuelPumps EQ 1
	/an24/Electrics/TsRUl_V GT 20.0<!--Relais (Item 945)-->
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_RK_CrewCab-RK_Navmain">
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/Electrics/FUSE_RK_CrewCab-RK_Navmain EQ 1
	/an24/Electrics/RK_CrewCab_V GE 24.0 <!--Relais (Item 1500)-->
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_AZSmain-RK_Navmain">
   <default value="1"/>
   <test logic="OR" value="0">
	/an24/Electrics/FUSE_AZSmain-RK_Navmain EQ 0
	/an24/Electrics/CONN_RK_CrewCab-RK_Navmain EQ 1.0
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_AZSmain-RK_Radiomain">
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/Electrics/FUSE_AZSmain-RK_Radiomain EQ 1
	/an24/Electrics/AZSmain_V GT 20.0 <!--Relais (Item 954)-->
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_RK_CrewCab-RK_Radiomain">
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/Electrics/FUSE_RK_CrewCab-RK_Radiomain EQ 1
	/an24/Electrics/CONN_AZSmain-RK_Radiomain EQ 0
   </test>
  </switch>

<!--
### Within RK_Akku ###-->
  <switch name="/an24/Electrics/CONN_Akku1-RK_Akku"> <!--Relais (Item 717)-->
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/Electrics/FUSE_Akku1 EQ 1
	/an24/RKCrew/sw01_batt1 EQ 1.0
	/an24/Electrics/DC_Batt_12SAM1_V GT 16.0
	<test logic="OR">
		/an24/Electrical_Panel/sw_board-aerodrome EQ 1.0
		/an24/Electrical_Panel/sw_emerg-bus EQ 1.0
		<test logic="AND">
			/an24/Electrical_Panel/sw_emerg-bus EQ -1.0
			/an24/Electrics/DMR-600Tl EQ 1
			/an24/Electrics/DMR-600Tr EQ 1
		</test>
	</test>
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_Akku2-RK_Akku"> <!--Relais (Item 718)-->
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/Electrics/FUSE_Akku2 EQ 1
	/an24/RKCrew/sw02_batt2 EQ 1.0
	/an24/Electrics/DC_Batt_12SAM2_V GT 16.0
	<test logic="OR">
		/an24/Electrical_Panel/sw_board-aerodrome EQ 1.0
		/an24/Electrical_Panel/sw_emerg-bus EQ 1.0
		<test logic="AND">
			/an24/Electrical_Panel/sw_emerg-bus EQ -1.0
			/an24/Electrics/DMR-600Tl EQ 1
			/an24/Electrics/DMR-600Tr EQ 1
		</test>
	</test>
   </test>
  </switch>

<!--
### RK_Akku to RK_CrewCab or AZSemerg ###-->
  <switch name="/an24/Electrics/CONN_RK_Akku-RK_CrewCab"><!--Item 1791, 1=relais not switched, 0=relais switched-->
   <default value="1"/>
   <test logic="OR" value="0">
	/an24/Electrics/FUSE_RK_Akku-RK_CrewCab EQ 0
	/an24/Electrics/CONN_RK_Akku-AZSemerg EQ 1
   </test>
  </switch>

  <switch name="/an24/Electrics/CONN_RK_Akku-AZSemerg"><!--Item 1791, 0=relais not switched, 1=relais switched-->
   <default value="0"/>
   <test logic="OR" value="1">
	  <test logic="AND">
		/an24/Electrics/FUSE_RK_Akku-AZSemerg EQ 1
		/an24/Electrical_Panel/sw_emerg-bus EQ 1.0<!--Manual-->
		<test logic="OR">
		<!--Relais needs some current to switch:-->
		/an24/Electrics/CONN_Akku1-RK_Akku EQ 1
		/an24/Electrics/CONN_Akku2-RK_Akku EQ 1
		</test>
	  </test>
 	  <test logic="AND">
		/an24/Electrics/FUSE_RK_Akku-AZSemerg EQ 1
		/an24/Electrical_Panel/sw_emerg-bus EQ -1.0<!--Auto-->
		/an24/Electrics/DMR-600Tl EQ 1
		/an24/Electrics/DMR-600Tr EQ 1
		<test logic="OR">
		<!--Relais needs some current to switch:-->
		/an24/Electrics/CONN_Akku1-RK_Akku EQ 1
		/an24/Electrics/CONN_Akku2-RK_Akku EQ 1
		</test>
	   </test>
   </test>
  </switch>

<!--
### Cross Connection ###-->
  <switch name="/an24/Electrics/CONN_AZSmain-AZSemerg"><!--Item 1545, 1=relais not switched, 0=relais switched-->
   <default value="1"/>
   <test logic="OR" value="0">
 	<test logic="AND">
		/an24/Electrical_Panel/sw_emerg-bus EQ 1.0<!--Manual-->
		<test logic="OR">
		<!--Relais needs some current to switch:-->
		/an24/Electrics/CONN_Akku1-RK_Akku EQ 1
		/an24/Electrics/CONN_Akku2-RK_Akku EQ 1
		</test>
   	</test>
 	<test logic="AND">
		/an24/Electrical_Panel/sw_emerg-bus EQ -1.0<!--Auto-->
		/an24/Electrics/DMR-600Tl EQ 1
		/an24/Electrics/DMR-600Tr EQ 1
		<test logic="OR">
		<!--Relais needs some current to switch:-->
		/an24/Electrics/CONN_Akku1-RK_Akku EQ 1
		/an24/Electrics/CONN_Akku2-RK_Akku EQ 1
		</test>
   	</test>
   </test>
  </switch>

 </channel>

<!-- DC VOLTAGES -->
 <channel name="DC_Voltages" execrate="16">

  <switch name="/an24/Electrics/TsRUl_V">
   <default value="0"/>
   <test value="/an24/Electrics/RK_Nacelle_V">
	/an24/Electrics/RK_Nacelle_V GT 16.0
   </test>
   <test logic="AND" value="/an24/Electrics/DC_Gen_18TMOparallel_V">
	/an24/Electrics/DMR-600Tl EQ 1
	/an24/Electrics/DMR-600Tr EQ 1
	<test logic="OR">
		/an24/Electrics/CONN_TsRUl-TsRUr EQ 1
		<test logic="AND">
		/an24/Electrics/CONN_TsRUr-RK_CrewCab EQ 1
		/an24/Electrics/CONN_RK_CrewCab-AZSmain EQ 1
		/an24/Electrics/CONN_TsRUl-AZSmain EQ 1
		</test>
	</test>
   </test>
   <test value="/an24/Electrics/DC_Gen_18TMOl_V">
	/an24/Electrics/DMR-600Tl EQ 1
   </test>
   <test logic="OR" value="/an24/Electrics/TsRUr_V">
	/an24/Electrics/CONN_TsRUl-TsRUr EQ 1
	<test logic="AND">
	/an24/Electrics/CONN_TsRUr-RK_CrewCab EQ 1
	/an24/Electrics/CONN_RK_CrewCab-AZSmain EQ 1
	/an24/Electrics/CONN_TsRUl-AZSmain EQ 1
	</test>
   </test>
   <test value="/an24/Electrics/AZSmain_V">
	/an24/Electrics/CONN_TsRUl-AZSmain EQ 1
   </test>
  </switch>

  <switch name="/an24/Electrics/TsRUr_V">
   <default value="0"/>
   <test logic="AND" value="/an24/Electrics/DC_Gen_18TMOparallel_V">
	/an24/Electrics/DMR-600Tl EQ 1
	/an24/Electrics/DMR-600Tr EQ 1
	<test logic="OR">
		/an24/Electrics/CONN_TsRUl-TsRUr EQ 1
		<test logic="AND">
		/an24/Electrics/CONN_TsRUr-RK_CrewCab EQ 1
		/an24/Electrics/CONN_RK_CrewCab-AZSmain EQ 1
		/an24/Electrics/CONN_TsRUl-AZSmain EQ 1
		</test>
	</test>
   </test>
   <test value="/an24/Electrics/DC_Gen_18TMOr_V">
	/an24/Electrics/DMR-600Tr EQ 1
   </test>
   <test value="/an24/Electrics/RK_CrewCab_V">
	/an24/Electrics/CONN_TsRUr-RK_CrewCab EQ 1
   </test>
   <test logic="OR" value="/an24/Electrics/TsRUl_V">
	/an24/Electrics/CONN_TsRUl-TsRUr EQ 1
	<test logic="AND">
	/an24/Electrics/CONN_TsRUr-RK_CrewCab EQ 1
	/an24/Electrics/CONN_RK_CrewCab-AZSmain EQ 1
	/an24/Electrics/CONN_TsRUl-AZSmain EQ 1
	</test>
   </test>
  </switch>

  <switch name="/an24/Electrics/RK_CrewCab_V">
   <default value="0"/>
   <test value="/an24/Electrics/TsRUr_V">
	/an24/Electrics/CONN_TsRUr-RK_CrewCab EQ 1
   </test>
   <test value="/an24/Electrics/AZSmain_V">
	/an24/Electrics/CONN_RK_CrewCab-AZSmain EQ 1
   </test>
   <test value="/an24/Electrics/TsRUr_V">
	/an24/Electrics/DMR-600Tr EQ 1
   </test>
   <test value="/an24/Electrics/RK_Akku_V">
	/an24/Electrics/CONN_RK_Akku-RK_CrewCab EQ 1
   </test>
  </switch>

  <switch name="/an24/Electrics/AZSmain_V">
   <default value="0"/>
   <test logic="AND" value="/an24/Electrics/TsRUl_V">
	/an24/Electrics/CONN_TsRUl-AZSmain EQ 1
	/an24/Electrics/DMR-600Tl EQ 1
   </test>
   <test value="/an24/Electrics/RK_CrewCab_V">
	/an24/Electrics/CONN_RK_CrewCab-AZSmain EQ 1
   </test>
   <test logic="OR" value="/an24/Electrics/AZSemerg_V">
	/an24/Electrics/FUSE_RK_CrewCab-AZSmaina EQ 0
	/an24/Electrics/FUSE_RK_CrewCab-AZSmainb EQ 0
   </test>
  </switch>

  <switch name="/an24/Electrics/AZSemerg_V">
   <default value="0"/>
   <test value="/an24/Electrics/AZSmain_V">
	/an24/Electrics/CONN_AZSmain-AZSemerg EQ 1
   </test>
   <test value="/an24/Electrics/RK_Akku_V">
	/an24/Electrics/CONN_RK_Akku-AZSemerg EQ 1
   </test>
  </switch>

  <switch name="/an24/Electrics/RK_Navmain_V">
   <default value="0"/>
   <test value="/an24/Electrics/RK_CrewCab_V">
	/an24/Electrics/CONN_RK_CrewCab-RK_Navmain EQ 1
   </test>
   <test value="/an24/Electrics/AZSmain_V">
	/an24/Electrics/CONN_AZSmain-RK_Navmain EQ 1
   </test>
  </switch>

  <switch name="/an24/Electrics/RK_FlAttmain_V">
   <default value="0"/>
   <test logic="AND" value="/an24/Electrics/TsRUr_V">
	/an24/Electrics/CONN_TsRUr-RK_FlAttmain EQ 1
	/an24/Electrics/CONN_TsRUl-RK_FlAttmain EQ 0
   </test>
   <test value="/an24/Electrics/TsRUl_V">
	/an24/Electrics/CONN_TsRUl-RK_FlAttmain EQ 1
   </test>
  </switch>

  <switch name="/an24/Electrics/RK_FlAttemerg_V">
   <default value="0"/>
   <test value="/an24/Electrics/AZSemerg_V">
	/an24/Electrics/CONN_AZSemerg-RK_FlAttemerg EQ 1
   </test>
  </switch>

  <switch name="/an24/Electrics/RK_FuelPumps_V">
   <default value="0"/>
   <test value="/an24/Electrics/TsRUl_V">
	/an24/Electrics/CONN_TsRUl-RK_FuelPumps EQ 1
   </test>
   <test value="/an24/Electrics/TsRUr_V">
	/an24/Electrics/CONN_TsRUr-RK_FuelPumps EQ 1
   </test>
  </switch>

 </channel>

<!--##########################################
#### ENGINE START
##############################################-->
 <channel name="Air-Ground Switch" execrate="10" execute="/an24/Electrics/StartCircuit/apdtime">

  <switch name="/an24/Electrics/StartCircuit/InAir-Ground_Start">
   <default value="0"/><!--in air-->
   <test value="1">
	/an24/Electrics/RK_CrewCab_V GT 16.0
	<!--/an24/Electrics/FUSExy EQ 1.0--><!--Item 1088-->
	/an24/Start-Panel/sw_ground-air EQ 1.0
   </test>
  </switch>

 </channel>

<!--##########################################
#### AC 36V/400Hz
##############################################-->
 <channel name="PT-1000" execrate="120">

  <switch name="/an24/Electrics/PT-1000"><!--1=Main; 2=Reserve-->
   <default value="0"/>
   <test logic="AND" value="1">
	/an24/RKCrew/sw03_pt-1000 EQ 1
	/an24/Electrical_Panel/sw_pt-1000 EQ 1
	/an24/Electrics/PT-1000main_working EQ 1
	/an24/Electrics/AZSmain_V GT 24.0
   </test>
   <test logic="AND" value="2">
	/an24/Electrical_Panel/sw_pt-1000 NE 0
	/an24/Electrics/PT-1000res_working EQ 1
	/an24/Electrics/AZSmain_V GT 24.0
   </test>
  </switch>

  <!--very, uhm, simplified!-->
  <switch name="/an24/Electrics/AC_Bus_36V_phII">
   <default value="0"/>
   <test logic="OR" value="36.0">
	/an24/Electrics/PT-1000 EQ 1
	/an24/Electrics/PT-1000 EQ 2
   </test>
  </switch>

  <!--AGD-1 left emergency support-->
  <switch name="/an24/Electrics/PT-125_V">
   <default value="0"/>
   <test logic="AND" value="36.0">
	/an24/Electrics/PT-1000 EQ 0
	/an24/Electrics/PT-125working EQ 1
   </test>
  </switch>

 </channel>

