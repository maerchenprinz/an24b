***** AC 115V/400Hz
**********************************************-->
 <channel name="GO-16l excitation" execrate="120">

  <switch name="/an24/Electrics/AC_Gen_GO16l_V_excit">
   <default value="0"/>
   <test value="1">
	/an24/AZS/sw0109 EQ 1
	/an24/Electrics/AZSemerg_V GT 20
   </test>
  </switch>

 </channel>

<!--property value="0.0">/an24/Electrics/AC_excit_kp</property>
<property value="0.0">/an24/Electrics/AC_excit_ki</property>
<property value="0.0">/an24/Electrics/AC_excit_kd</property-->

 <channel name="GO-16l Voltage and Frequency" execrate="16">

 <fcs_function name="/an24/Electrics/AC_Gen_GO16l_V">
  <function>

 <product>
 <property>/an24/Electrical_Panel/go-16l_voltreg</property>
 <property>/an24/Electrics/random_go16l</property>
 <property>/an24/Electrics/AC_Gen_GO16l_V_excit</property>
 <sum>
  <pow>
   <difference>
    <quotient>
    <property>propulsion/engine[0]/engine-rpm-percent</property>
    <value>100</value>
    </quotient>
   <value>1.1</value>
   </difference>
  <value>5.0</value>
  </pow>
 <value>1.0</value>
 </sum>
 </product>

  </function>
  <clipto>
   <min>0.0</min>
   <max>200.0</max>
  </clipto>
 </fcs_function>

