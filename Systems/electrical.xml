#### LIGHTING
##############################################-->
 <channel name="Lighting switch" execrate="120">

  <switch name="/controls/lighting/lamps_have_power"><!--listener for electrical.nas-->
   <default value="0"/>
   <test value="1">
	/an24/Electrics/AZSmain_V GT 23.0
   </test>
  </switch>

 </channel>

