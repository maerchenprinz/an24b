<?xml version="1.0"?>

<!-- Signal lamp -->
<PropertyList>
 <path>../../shared/lamps/sltsn.ac</path>

 <animation>
  <type>material</type>
  <object-name>holder</object-name>
  <object-name>lampon</object-name>
  <texture>../../shared/lamps/warninglamp02green.png</texture>
 </animation>

 <animation>
  <type>scale</type>
  <object-name>holder</object-name>
  <object-name>lampon</object-name>
  <x-offset>0.5</x-offset>
  <y-offset>0.5</y-offset>
  <z-offset>0.5</z-offset>
 </animation>

 <animation>
  <type>select</type>
  <object-name>lampon</object-name>
  <condition>
   <equals>
    <property>an24/foo/bar</property>
    <value>1.0</value>
   </equals>
  </condition>
 </animation>

</PropertyList>
