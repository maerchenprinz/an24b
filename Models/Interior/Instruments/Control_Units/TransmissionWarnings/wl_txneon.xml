<?xml version="1.0"?>

<!-- Warning light "NEON Radio Transmission" (may interfere other instruments) -->
<PropertyList>
 <path>../../../shared/lamps/sltsn.ac</path>

<animation>
 <type>material</type>
 <object-name>holder</object-name>
 <object-name>lampon</object-name>
 <texture>../../../shared/lamps/sltsnorangeplain.png</texture>
</animation>

<animation>
 <type>select</type>
 <condition>
  <and>
   <greater-than>
    <property>an24/Electrics/AZSmain_V</property>
    <value>24.0</value>
   </greater-than>
   <equals>
    <property>controls/radios/comm-ptt</property>
    <value>1</value>
   </equals>
   <or>
    <equals>
     <property>controls/radios/comm-radio-selected</property>
     <value>2</value>
    </equals>
    <equals>
     <property>controls/radios/comm-radio-selected</property>
     <value>3</value>
    </equals>
   </or>
  </and>
  </condition>
 <object-name>lampon</object-name>
</animation>

</PropertyList>
