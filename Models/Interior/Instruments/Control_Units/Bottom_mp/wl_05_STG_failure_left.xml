<?xml version="1.0"?>

<!-- STG-18 DC generator failure warning light (Item 1145); lights when differential-minimum relay DMR-600T disconnects the generator -->
<PropertyList>
 <path>../../../shared/lamps/sltsn.ac</path>

 <animation>
  <type>material</type>
  <object-name>holder</object-name>
  <object-name>lampon</object-name>
  <texture>../../../shared/lamps/sltsnredplain.png</texture>
 </animation>

 <animation>
  <type>select</type>
  <condition>
   <and>
    <greater-than>
     <property>an24/Electrics/AZSemerg_V</property>
     <value>24.0</value>
    </greater-than>
    <equals>
     <property>an24/Electrics/DMR-600Tl</property>
     <value>0.0</value>
    </equals>
   </and>
  </condition>
  <object-name>lampon</object-name>
 </animation>

</PropertyList>
