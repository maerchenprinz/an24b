<?xml version="1.0"?>

<!-- Lamp indicating "Feathering Pump working" (Item 78) -->
<PropertyList>
 <path>../../shared/lamps/warninglamp02.ac</path>

 <animation>
  <type>material</type>
  <object-name>holder</object-name>
  <object-name>lampon</object-name>
  <texture>../../shared/lamps/warninglamp02red.png</texture>
 </animation>

 <animation>
  <type>select</type>
  <condition>
   <and>
    <greater-than>
     <property>an24/Electrics/TsRUl_V</property>
     <value>20.0</value>
    </greater-than>
    <greater-than>
     <property>fdm/jsbsim/fcs/prop-governor[0]/NF-pump-rate</property>
     <value>0.0</value>
    </greater-than>
   </and>
  </condition>
  <object-name>lampon</object-name>
 </animation>

</PropertyList>
