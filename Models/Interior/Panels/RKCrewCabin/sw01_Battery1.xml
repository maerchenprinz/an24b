<?xml version="1.0"?>

<!-- Switch to monitor Battery 1 (Item 2056) -->
<PropertyList>
 <path>../../shared/switches/azr.ac</path>
 
 <animation>
  <type>pick</type>
  <object-name>clickspot_up</object-name>
  <visible>false</visible>
  <action>
    <button>0</button>
    <repeatable>false</repeatable>
    <binding>
      <command>nasal</command>
      <script>
	interpolate("an24/RKCrew/sw01_batt1", 1.0, 0.1 );
	sound.click("azr", 3.36, 0.95, 0.1);
      </script>
    </binding>
  </action>
   <hovered>
    <binding>
      <command>set-tooltip</command>
      <tooltip-id>akk1on</tooltip-id>
      <label>   Monitor
Battery 1 ON</label>
    </binding>
   </hovered>
 </animation>

<animation>
  <type>pick</type>
  <object-name>clickspot_down</object-name>
  <visible>false</visible>
  <action>
    <button>0</button>
    <repeatable>false</repeatable>
    <binding>
      <command>nasal</command>
      <script>
	interpolate("an24/RKCrew/sw01_batt1", 0.0, 0.1 );
	sound.click("azr", 3.36, 0.95, 0.1);
      </script>
    </binding>
  </action>
</animation>

 <animation>
   <type>rotate</type>
   <object-name>lever</object-name>
   <property>an24/RKCrew/sw01_batt1</property>
  <interpolation>
    <entry><ind>0.0</ind><dep>-20.0</dep></entry>
    <entry><ind>1.0</ind><dep>20.0</dep></entry>
  </interpolation>
  <axis>
    <x>0.0</x>
    <y>-1.0</y>
    <z>0.0</z>
  </axis>
 </animation>

</PropertyList>
