    <entry><ind>1.0</ind><dep>-0.18</dep></entry>
  </interpolation>
  <axis>
    <x>0</x>
    <y>1</y>
    <z>0</z>    
  </axis>
 </animation>

 <animation>
  <type>translate</type>
  <object-name>BagDoor</object-name>
