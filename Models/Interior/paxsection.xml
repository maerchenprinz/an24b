    <z>1</z>    
  </axis>
 </animation>

 <animation>
  <type>rotate</type>
  <object-name>BagDoor</object-name>
  <property>an24/DoorsHatches/bagdoor</property>
  <interpolation>
   <entry><ind>0.0</ind><dep>0.0</dep></entry>
   <entry><ind>0.15</ind><dep>0.0</dep></entry>
   <entry><ind>1.0</ind><dep>7.0</dep></entry>
  </interpolation>
  <center>
    <x-m>17.2</x-m>
    <y-m>0.0</y-m>
    <z-m>0.0</z-m>    
  </center>
  <axis>
    <x>0</x>
    <y>0</y>
    <z>-1</z>    
  </axis>
 </animation>

</PropertyList>
