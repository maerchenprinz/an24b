    <entry><ind>1.0</ind><dep>-0.50</dep></entry>
  </interpolation>
  <axis>
    <x>-1</x>
    <y>0</y>
    <z>0</z>    
  </axis>
 </animation>

 <animation>
  <type>translate</type>
  <object-name>BagDoor</object-name>
  <property>an24/DoorsHatches/bagdoor</property>
  <interpolation>
    <entry><ind>0.0</ind><dep>0.0</dep></entry>
    <entry><ind>0.15</ind><dep>0.0</dep></entry>
    <entry><ind>1.0</ind><dep>0.02</dep></entry>
  </interpolation>
  <axis>
